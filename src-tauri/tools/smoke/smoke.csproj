<Project Sdk="Microsoft.NET.Sdk">

  <!-- CI smoke checks for the parts the shell bundles: the published core
       through the contract's handshake, and the search library with the real
       model. Written for the macOS runner; runs anywhere. Not shipped. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>tessera-smoke</AssemblyName>
    <RootNamespace>Tessera.Smoke</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\search\src\Tessera.Desktop.Search\Tessera.Desktop.Search.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

</Project>
