<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The executable the shell spawns: tessera-core(.exe). CONTRACT §8. -->
    <AssemblyName>tessera-core</AssemblyName>
    <RootNamespace>Tessera.Api</RootNamespace>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Not single-file: the native libraries (Skia, e_sqlite3, later ONNX
         Runtime) sit beside the exe and are signed one by one. CONTRACT §8. -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- For the one P/Invoke (battery state on Windows), source-generated. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Thumbnails and the model input. The base package carries the native
         libraries for Windows and macOS. -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tessera.Core\Tessera.Core.csproj" />
    <ProjectReference Include="..\Tessera.Data\Tessera.Data.csproj" />
    <!-- The frozen interface to the search library (CONTRACT §6). Read, never
         edited from here. The real implementation is registered by the
         coordinator once it is merged; until then Search/Fake*.cs stand in. -->
    <ProjectReference Include="..\..\..\search\src\Tessera.Desktop.Search.Abstractions\Tessera.Desktop.Search.Abstractions.csproj" />
  </ItemGroup>

</Project>
