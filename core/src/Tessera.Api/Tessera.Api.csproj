<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>tessera</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Verifies the bcrypt hashes carried over from Immich ($2b$10$...), so
         existing passwords keep working and no password is ever reset during
         the migration. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Thumbnails. SkiaSharp rather than ImageSharp: MIT, and the native
         assets package is the supported way to run it in a Linux container. -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tessera.Core\Tessera.Core.csproj" />
    <ProjectReference Include="..\Tessera.Data\Tessera.Data.csproj" />
  </ItemGroup>

</Project>
